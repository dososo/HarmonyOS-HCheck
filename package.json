{
  "name": "hongjian-hcheck",
  "version": "0.6.0",
  "private": true,
  "packageManager": "pnpm@10.34.0",
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.4"
    }
  },
  "description": "鸿鉴 HCheck：HarmonyOS 应用发布就绪审查与证据编排 CLI",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "pnpm": "10.34.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "node --test scripts/test/*.test.mjs && pnpm -r --if-present test",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck",
    "lint:code": "eslint packages adapters scripts",
    "format:check": "prettier --check \"packages/**/*.ts\" \"adapters/**/*.ts\" \"scripts/**/*.mjs\" eslint.config.mjs",
    "format": "prettier --write \"packages/**/*.ts\" \"adapters/**/*.ts\" \"scripts/**/*.mjs\" eslint.config.mjs",
    "lint": "pnpm lint:code && pnpm format:check",
    "docs:check": "node scripts/validate-docs.mjs",
    "schema:check": "node scripts/validate-schemas.mjs",
    "sbom:check": "node scripts/generate-sbom.mjs --check",
    "package:cli": "node scripts/package-cli.mjs",
    "hcheck": "node packages/cli/dist/index.js",
    "security:deps": "pnpm audit --prod && pnpm sbom:check",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check && pnpm schema:check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.7.0",
    "prettier": "3.9.5",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "yaml": "2.9.0",
    "typescript-eslint": "8.63.0"
  }
}
