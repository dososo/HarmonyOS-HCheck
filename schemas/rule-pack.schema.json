{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hcheck.dev/schemas/rule-pack.schema.json",
  "title": "HCheck 规则包",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "hcheck_compatibility", "rules"],
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "hcheck_compatibility": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(?:>=|>|<=|<|=)?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\s+(?:>=|>|<=|<|=)?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?)*$"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.ya?ml$"
      }
    }
  }
}
