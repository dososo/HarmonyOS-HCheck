{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hcheck.dev/schemas/rule.schema.json",
  "title": "HCheck 规则定义",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "status",
    "title",
    "summary",
    "category",
    "applies_when",
    "inputs",
    "detector",
    "severity",
    "default_confidence",
    "policy_refs",
    "remediation",
    "autofix"
  ],
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^HOS-[A-Z]+-[0-9]{3}$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "status": {
      "type": "string",
      "enum": [
        "experimental",
        "active",
        "deprecated"
      ],
      "default": "experimental"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 4096
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technical",
        "review"
      ],
      "properties": {
        "technical": {
          "type": "string",
          "maxLength": 128
        },
        "review": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "applies_when": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "object",
          "oneOf": [
            {
              "additionalProperties": false,
              "required": ["all"],
              "properties": {
                "all": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "minItems": 1,
                  "maxItems": 32
                }
              }
            },
            {
              "additionalProperties": false,
              "required": ["any"],
              "properties": {
                "any": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "minItems": 1,
                  "maxItems": 32
                }
              }
            }
          ]
        }
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "project_snapshot",
          "source_text",
          "source_ast",
          "dependency_graph",
          "privacy_policy",
          "package_manifest",
          "tool_report",
          "agc_snapshot",
          "runtime_timeline",
          "manual_attestation"
        ]
      },
      "minItems": 1,
      "maxItems": 9,
      "uniqueItems": true
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "implementation"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "structural",
            "semantic",
            "artifact",
            "composite",
            "runtime",
            "manual"
          ]
        },
        "implementation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "BLOCKER",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFO"
      ]
    },
    "default_confidence": {
      "type": "string",
      "enum": [
        "CONFIRMED",
        "PROBABLE",
        "POSSIBLE",
        "MANUAL"
      ]
    },
    "policy_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "section",
          "url",
          "verified_at"
        ],
        "properties": {
          "source": {
            "type": "string",
            "maxLength": 256
          },
          "section": {
            "type": "string",
            "maxLength": 512
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "verified_at": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "verification"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 5,
          "maxLength": 4096
        },
        "verification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "details": {
          "type": "string",
          "maxLength": 8192
        }
      }
    },
    "autofix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "allowed",
            "review_required",
            "forbidden"
          ]
        },
        "implementation": {
          "type": "string",
          "maxLength": 256
        },
        "allowed_paths": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "known_false_positives": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "maxLength": 128
      },
      "uniqueItems": true
    },
    "introduced_at": {
      "type": "string",
      "format": "date"
    },
    "deprecated_by": {
      "type": "string",
      "pattern": "^HOS-[A-Z]+-[0-9]{3}$"
    }
  }
}
