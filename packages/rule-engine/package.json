{
  "name": "@hcheck/rule-engine",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "description": "规则加载与执行引擎",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hcheck/core": "workspace:*",
    "@hcheck/project-model": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsonc-eslint-parser": "3.1.0",
    "minimatch": "10.2.5",
    "semver": "7.8.5",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/semver": "7.7.1"
  }
}
